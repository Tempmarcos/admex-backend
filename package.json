{
  "name": "admex",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest",
    "build": "tsup src",
    "dev": "tsx watch src/server.ts",
    "docker:build": "docker build -t admex_backend docker",
    "docker:run": "docker run -it -v $(pwd)/.:/app admex_backend bash",
    "compose:up": "docker compose --env-file ./.env -f docker/docker-compose.yml up -d --build",
    "compose:down": "docker compose -f docker/docker-compose.yml down",
    "compose:exec": "docker compose --env-file ./.env -f docker/docker-compose.yml exec -it backend bash"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/node-schedule": "^2.1.7",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.17.2",
    "prisma": "^6.2.1",
    "redis": "^5.6.0",
    "zod": "^3.24.1"
  }
}
