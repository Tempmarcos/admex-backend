generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  admin        Boolean  @default(false)
  nome         String
  email        String   @unique
  senha        String
  created_at   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  permissoes   String[]
  perfil       Perfil?
  empresaId    String
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tarefa       Tarefa[] @relation(name: "responsavel")
  tarefaCriada Tarefa[] @relation(name: "criador")
}

model Perfil {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  foto          String?
  nomeDeUsuario String
  tema          String  @default("default")
}

model Empresa {
  id               String            @id @default(uuid())
  ativa            Boolean
  dataCadastro     DateTime          @default(now())
  usuarios         User[]
  clientes         Cliente[]
  fornecedores     Fornecedor[]
  produtos         Produto[]
  servicos         Servico[]
  propostas        Proposta[]
  tarefas          Tarefa[]
  DadosGerais      DadosGerais?
  DadosFiscais     DadosFiscais?
  DadosFinanceiros DadosFinanceiros?
  convites         Convite[]
}

model DadosGerais {
  id             String    @id @default(uuid())
  nome           String
  nomeFantasia   String
  dataDeFundacao DateTime
  logo           String?
  endereco       Endereco?
  empresaId      String    @unique
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Endereco {
  id            String       @id @default(uuid())
  DadosGeraisId String?      @unique
  DadosGerais   DadosGerais? @relation(fields: [DadosGeraisId], references: [id], onDelete: Cascade)
  clienteId     String?      @unique
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fornecedorId  String?      @unique
  fornecedor    Fornecedor?  @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  pais          String // BR, US, JP
  dados         Json // Campos específicos do país
}

model Contato {
  id           String      @id @default(uuid())
  nome         String
  cargo        String
  email        String?
  telefone     String?
  ClienteId    String?     @unique
  Cliente      Cliente?    @relation(fields: [ClienteId], references: [id], onDelete: Cascade)
  FornecedorId String?     @unique
  Fornecedor   Fornecedor? @relation(fields: [FornecedorId], references: [id], onDelete: Cascade)
}

model DadosFiscais {
  id                String  @id @default(uuid())
  registro          String  @unique
  classificacao     String  @default("")
  camposEspecificos Json?
  empresaId         String  @unique
  empresa           Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model DadosFinanceiros {
  id            String      @id @default(uuid())
  banco         String?
  agencia       String?
  conta         String?
  pix           String?
  empresaId     String?     @unique
  empresa       Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedorId  String?     @unique
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
}

model Cliente {
  id         String     @id @default(uuid())
  created_at DateTime @default(now())
  updatedAt  DateTime @updatedAt
  nome       String
  empresaId  String
  registro   String
  contato    Contato?
  endereco   Endereco?
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  propostas  Proposta[]
}

model Fornecedor {
  id               String            @id @default(uuid())
  created_at       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  nome             String
  empresaId        String
  registro         String
  contato          Contato?
  endereco         Endereco?
  dadosFinanceiros DadosFinanceiros?
  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produtos         Produto[]
  servicos         Servico[]
}

model Produto {
  id            String  @id @default(uuid())
  created_at    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tipo          String
  nome          String
  descricao     String
  preco         Float
  estoque       Int?
  unidadeMedida String?
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  Fornecedor    Fornecedor[]
}

model Servico {
  id           String  @id @default(uuid())
  created_at   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tipo         String
  nome         String
  descricao    String
  preco        Float
  duracao      Int?
  empresaId    String
  empresa      Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  Fornecedor   Fornecedor[]
}
//@updatedAt
model Tarefa {
  id                String    @id @default(uuid())
  nome              String
  descricao         String?
  userResponsavelId String
  userCriadorId     String
  responsavel       User      @relation("responsavel", fields: [userResponsavelId], references: [id], onDelete: Cascade)
  criador           User      @relation("criador", fields: [userCriadorId], references: [id], onDelete: Cascade)
  tipo              String
  status            String
  dataAgendada      DateTime?
  dataExecutada     DateTime?
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Proposta {
  id            String           @id @default(uuid())
  codigo        String           @unique
  tituloProjeto String?
  descricao     String?
  endereco      String?
  clienteId     String
  cliente       Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  status        String           
  revisoes      Revisao[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  empresaId     String
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Revisao {
  id           String            @id @default(uuid())
  proposta     Proposta          @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  propostaId   String
  dataProposta DateTime          @default(now())
  valorTotal   String
  numeroRevisao Int
  itens        ItemProposta[]
  createdAt    DateTime          @default(now())
  aprovado     Boolean           @default(false)
  executado    Boolean           @default(false)

  @@unique([propostaId, numeroRevisao])
}

model ItemProposta {
  id               String          @id @default(uuid())
  nome             String
  preco            String
  quantidade       Int
  unidadeDeMedida  String          @default("Unid")
  Revisao          Revisao? @relation(fields: [RevisaoId], references: [id], onDelete: Cascade)
  RevisaoId String?
}

model ErrorLog {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  timestamp DateTime @default(now())
  metadata  Json?
}

model Convite {
  id         String   @id @default(uuid())
  token      String   @unique
  usado      Boolean  @default(false)
  cancelado  Boolean  @default(false)
  created_at DateTime @default(now())
  expires_at DateTime
  created_by String
  used_by    String?
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}
