generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  admin      Boolean  @default(false)
  nome       String
  email      String   @unique
  senha      String
  created_at DateTime @default(now())
  updatedAt  DateTime @updatedAt
  permissoes String[]
  perfil     Perfil?
  empresaId  String   @unique
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
}

model Perfil {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  foto          String?
  nomeDeUsuario String
  tema          String  @default("default")
  fonte         Int     @default(9)
}

model Empresa {
  id               String            @id @default(uuid())
  ativa            Boolean
  dataCadastro     DateTime          @default(now())
  usuarios         User[]
  clientes         Cliente[]
  fornecedores     Fornecedor[]
  itens            ItemDeVenda[]
  propostas        Proposta[]
  DadosGerais      DadosGerais?
  DadosFiscais     DadosFiscais?
  DadosFinanceiros DadosFinanceiros?
}

model DadosGerais {
  id             String    @id @default(uuid())
  nome           String
  dataDeFundacao DateTime
  logo           String?
  endereco       Endereco?
  empresaId      String    @unique
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
}

model Endereco {
  id            String       @id @default(uuid())
  DadosGeraisId String?      @unique
  DadosGerais   DadosGerais? @relation(fields: [DadosGeraisId], references: [id])
  clienteId     String?      @unique
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  fornecedorId  String?      @unique
  fornecedor    Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  pais          String // BR, US, JP
  dados         Json // Campos específicos do país
}

model Contato {
  id           String      @id @default(uuid())
  nome         String
  cargo        String
  email        String?
  telefone     String?
  ClienteId    String?     @unique
  Cliente      Cliente?    @relation(fields: [ClienteId], references: [id])
  FornecedorId String?     @unique
  Fornecedor   Fornecedor? @relation(fields: [FornecedorId], references: [id])
}

model DadosFiscais {
  id                String      @id @default(uuid())
  registro          String      @unique
  classificacao     String
  camposEspecificos Json?
  empresaId         String?     @unique
  empresa           Empresa?    @relation(fields: [empresaId], references: [id])
  clienteId         String?     @unique
  cliente           Cliente?    @relation(fields: [clienteId], references: [id])
  fornecedorId      String?     @unique
  fornecedor        Fornecedor? @relation(fields: [fornecedorId], references: [id])
}

model DadosFinanceiros {
  id            String  @id @default(uuid())
  contaBancaria String
  empresaId     String  @unique
  empresa       Empresa @relation(fields: [empresaId], references: [id])
}

model Cliente {
  id           String        @id @default(uuid())
  nome         String
  empresaId    String
  contato      Contato?
  endereco     Endereco?
  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  propostas    Proposta[]
  dadosFiscais DadosFiscais?
}

model Fornecedor {
  id           String        @id @default(uuid())
  nome         String
  empresaId    String
  Contato      Contato?
  Endereco     Endereco?
  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  DadosFiscais DadosFiscais?
}

model ItemDeVenda {
  id        String  @id @default(uuid())
  tipo      String
  nome      String
  descricao String
  preco     Float
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}

model Proposta {
  id           String   @id @default(uuid())
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  dataProposta DateTime @default(now())
  valorTotal   Float
  status       String
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
}

model ErrorLog {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  timestamp DateTime @default(now())
  metadata  Json?
}
