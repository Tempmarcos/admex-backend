generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  admin      Boolean  @default(false)
  nome       String
  email      String   @unique
  senha      String
  created_at DateTime @default(now())
  updatedAt  DateTime @updatedAt
  permissoes String[]
  perfil     Perfil?
  empresaId  String   @unique
  empresa    Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Perfil {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  foto          String?
  nomeDeUsuario String
  tema          String  @default("default")
  fonte         Int     @default(9)
}

model Empresa {
  id               String            @id @default(uuid())
  ativa            Boolean
  dataCadastro     DateTime          @default(now())
  usuarios         User[]
  clientes         Cliente[]
  fornecedores     Fornecedor[]
  produtos         Produto[]
  servicos         Servico[]
  propostas        Proposta[]
  DadosGerais      DadosGerais?
  DadosFiscais     DadosFiscais?
  DadosFinanceiros DadosFinanceiros?
}

model DadosGerais {
  id             String    @id @default(uuid())
  nome           String
  dataDeFundacao DateTime
  logo           String?
  endereco       Endereco?
  empresaId      String    @unique
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Endereco {
  id            String       @id @default(uuid())
  DadosGeraisId String?      @unique
  DadosGerais   DadosGerais? @relation(fields: [DadosGeraisId], references: [id], onDelete: Cascade)
  clienteId     String?      @unique
  cliente       Cliente?     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  fornecedorId  String?      @unique
  fornecedor    Fornecedor?  @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  pais          String // BR, US, JP
  dados         Json // Campos específicos do país
}

model Contato {
  id           String      @id @default(uuid())
  nome         String
  cargo        String
  email        String?
  telefone     String?
  ClienteId    String?     @unique
  Cliente      Cliente?    @relation(fields: [ClienteId], references: [id], onDelete: Cascade)
  FornecedorId String?     @unique
  Fornecedor   Fornecedor? @relation(fields: [FornecedorId], references: [id], onDelete: Cascade)
}

model DadosFiscais {
  id                String  @id @default(uuid())
  registro          String  @unique
  classificacao     String
  camposEspecificos Json?
  empresaId         String  @unique
  empresa           Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model DadosFinanceiros {
  id            String      @id @default(uuid())
  contaBancaria String
  empresaId     String?     @unique
  empresa       Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedorId  String?     @unique
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
}

model Cliente {
  id        String     @id @default(uuid())
  nome      String
  empresaId String
  registro  String
  contato   Contato?
  endereco  Endereco?
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  propostas Proposta[]
}

model Fornecedor {
  id               String            @id @default(uuid())
  nome             String
  empresaId        String
  registro         String
  contato          Contato?
  endereco         Endereco?
  dadosFinanceiros DadosFinanceiros?
  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Produto {
  id            String  @id @default(uuid())
  tipo          String
  nome          String
  descricao     String
  preco         Float
  estoque       Int?
  unidadeMedida String?
  empresaId     String
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Servico {
  id        String  @id @default(uuid())
  tipo      String
  nome      String
  descricao String
  preco     Float
  duracao   Int?
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Proposta {
  id           String   @id @default(uuid())
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  dataProposta DateTime @default(now())
  valorTotal   Float
  status       String
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model ErrorLog {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  timestamp DateTime @default(now())
  metadata  Json?
}
